{
  "name": "copilot-pr-review",
  "version": "0.1.0",
  "description": "Parallel AI code review for GitHub pull requests using GitHub Copilot CLI and Agent Plugins.",
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/**/*.test.mjs' 'tests/**/*.test.js'",
    "review": "node scripts/dogfood-review.mjs",
    "dogfood:pr": "node scripts/dogfood-pr.mjs",
    "self-review": "node scripts/self-review.mjs",
    "ci-review": "node scripts/ci-action.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/bump-version.mjs auto --release"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "copilot",
    "copilot-cli",
    "agent-plugin",
    "agent-skills",
    "pr-review",
    "code-review"
  ]
}
